# Poolsy Backend Environment Variables

# Flask Secret Key for JWT and sessions (Required)
SECRET_KEY=dev_secret

# Database connection URL (Required)
# Local SQLite example: sqlite:///instance/poolsy.db
# Production PostgreSQL example: postgresql://user:password@rds-endpoint.aws.com:5432/poolsy
DATABASE_URL=postgresql://user:password@localhost/poolsy

# AWS Region for existing AI Scanner functionality (Required if using AI receipt scanner)
AWS_REGION=us-east-1

# S3 Bucket for receipt images (Required if using AI receipt scanner)
S3_BUCKET=poolsy-receipts
